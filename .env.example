# ---- Venice E2EE Proxy configuration ----

# Your Venice API key (required). Get one at https://venice.ai
VENICE_API_KEY=your-venice-api-key

# Port the proxy listens on (default: 4337)
PORT=4337

# Host/interface to bind (default: 0.0.0.0)
HOST=0.0.0.0

# E2EE session cache TTL in milliseconds (default: 1800000 = 30 minutes)
SESSION_TTL_MS=1800000

# Verify the TEE attestation when creating an E2EE session (default: true).
# Set to false only for debugging — it disables a key security guarantee.
VERIFY_ATTESTATION=true

# Run full Intel TDX DCAP verification (PCK cert chain, quote signature, TCB
# evaluation) via @phala/dcap-qvl, in addition to the default binding checks.
# Enabled by default. Set to false to skip it. Only effective when
# VERIFY_ATTESTATION=true.
VERIFY_DCAP=true

# Optional PCCS server URL used for DCAP collateral fetching.
# Defaults to the Phala PCCS (https://pccs.phala.network) when unset.
# DCAP_PCCS_URL=https://pccs.phala.network

# Enforce NVIDIA GPU attestation before establishing an E2EE session (default: true).
# When enabled, the proxy fetches /tee/attestation, checks verified + nonce, and
# requires Venice's server-side NVIDIA verification to pass for GPU-backed models
# (fails closed otherwise). NOTE: this enforces Venice's GPU verdict; it is not yet
# an independent client-side verification of the NVIDIA quote. Set to false to skip.
VERIFY_GPU_ATTESTATION=true

# Venice API base URL (default: https://api.venice.ai)
BASE_URL=https://api.venice.ai

# Max request body size accepted by the proxy (default: 25mb). Accepts any
# `bytes`-compatible value (e.g. 100kb, 10mb). Raise it if you send very large
# chat histories or base64-encoded images.
MAX_BODY_SIZE=25mb

# Logging verbosity (default: info). One of:
#   error | warn | info | debug | verbose   (each includes the less-verbose ones)
# Use "debug" to see detailed per-request tracing (routing, encryption counts,
# upstream timings, stream chunk counts). Secrets and message contents are never logged.
LOG_LEVEL=info
